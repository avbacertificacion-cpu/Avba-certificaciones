# Este directorio solo debe servir imágenes.
# Bloquea la ejecución de cualquier script que llegara a colarse aquí.

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|pl|py|cgi|sh|asp|aspx|jsp)$">
    Require all denied
</FilesMatch>

php_flag engine off

Options -Indexes -ExecCGI
AddHandler default-handler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Disposition "inline"
</IfModule>
