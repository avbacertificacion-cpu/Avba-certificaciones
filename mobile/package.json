{
  "name": "avba-certificaciones-app",
  "version": "2.0.0",
  "private": true,
  "description": "App móvil (Android / iOS) de AVBA Certificaciones: lleva las pantallas dentro y trabaja sin señal",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "sync": "npm run build && cap sync",
    "sync:android": "npm run build && cap sync android",
    "sync:ios": "npm run build && cap sync ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "icons": "capacitor-assets generate --assetPath assets --iconBackgroundColor '#ffffff' --iconBackgroundColorDark '#0B2545' --splashBackgroundColor '#0B2545' --splashBackgroundColorDark '#0B2545'",
    "paquete": "node scripts/paquete-servidor.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.2",
    "@capacitor/geolocation": "^8.2.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/capacitor-native-biometric": "^8.9.3",
    "@capgo/capacitor-updater": "^8.54.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  },
  "avba": {
    "nativoMinimo": "2.0.0",
    "_nota": "Súbelo a la versión de la app cuando agregues un plugin o permiso nativo: los teléfonos con una app más vieja no recibirán pantallas que lo necesiten y verán el aviso de actualizar en la tienda."
  }
}
