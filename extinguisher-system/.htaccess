DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # CRÍTICO: No reescribir archivos y directorios que existen
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # CRÍTICO: No reescribir /api/* - DEBEN SERVIRSE DIRECTAMENTE
    RewriteRule ^api/ - [L]

    # CRÍTICO: No reescribir /public/* - DEBEN SERVIRSE DIRECTAMENTE
    RewriteRule ^public/ - [L]

    # Ruta especial para validación de códigos QR desde URL raíz
    RewriteCond %{QUERY_STRING} qr=
    RewriteRule ^$ /extintores/public/validar-extintor.html [L,QSA]

    # Todas las demás rutas van a index.php (routing interno)
    RewriteRule ^ /extintores/index.php [L]
</IfModule>

# Ocultar errores PHP al usuario
php_flag display_errors Off

# Permitir acceso a cámara para el scanner QR
<IfModule mod_headers.c>
    Header set Permissions-Policy "camera=(self)"
</IfModule>
