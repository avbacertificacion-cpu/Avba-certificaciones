DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # IMPORTANTE: No reescribir archivos y directorios reales
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # No reescribir /api/* - servir directamente
    RewriteCond %{REQUEST_URI} ^/extintores/api/ [NC]
    RewriteRule ^ - [L]

    # No reescribir /public/* - servir directamente
    RewriteCond %{REQUEST_URI} ^/extintores/public/ [NC]
    RewriteRule ^ - [L]

    # Ruta especial para validación de códigos QR desde URL raíz
    # Reescribir /?qr=... a /public/validar-extintor.html?qr=...
    RewriteCond %{QUERY_STRING} qr=
    RewriteRule ^$ /extintores/public/validar-extintor.html [L,QSA]

    # Todas las demás rutas van a index.php (routing interno)
    RewriteRule ^ /extintores/index.php [L]
</IfModule>

# Ocultar errores PHP al usuario
php_flag display_errors Off

# Permitir acceso a cámara para el scanner QR
<IfModule mod_headers.c>
    Header set Permissions-Policy "camera=(self)"
</IfModule>
