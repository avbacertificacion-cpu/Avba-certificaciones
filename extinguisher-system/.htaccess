DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Ruta especial para validación de códigos QR desde URL raíz
    # QSA = Query String Append (preserva ?qr= parameter)
    RewriteCond %{QUERY_STRING} qr=
    RewriteRule ^$ public/validar-extintor.html [L,QSA]

    # Rutas normales - PERO EXCLUIR /api, /public, y archivos reales
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/api/ [NC]
    RewriteCond %{REQUEST_URI} !^/public/ [NC]
    RewriteRule ^ index.php [L]
</IfModule>

# Ocultar errores PHP al usuario
php_flag display_errors Off

# Permitir acceso a cámara para el scanner QR
<IfModule mod_headers.c>
    Header set Permissions-Policy "camera=(self)"
</IfModule>
