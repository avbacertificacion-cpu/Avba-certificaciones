DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ══════════════════════════════════════════════════════════════════════════
    # PASO 1: Proteger archivos y directorios reales
    # ══════════════════════════════════════════════════════════════════════════
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ══════════════════════════════════════════════════════════════════════════
    # PASO 2: Proteger endpoints y directorios específicos (por patrón URI)
    # ══════════════════════════════════════════════════════════════════════════
    RewriteCond %{REQUEST_URI} ^/extintores/api/ [NC]
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_URI} ^/extintores/public/ [NC]
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_URI} ^/extintores/config/ [NC]
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_URI} ^/extintores/private/ [NC]
    RewriteRule ^ - [L]

    # ══════════════════════════════════════════════════════════════════════════
    # PASO 3: Manejo especial para raíz con parámetro ?qr=
    # ══════════════════════════════════════════════════════════════════════════
    RewriteCond %{QUERY_STRING} ^qr=
    RewriteRule ^/?$ public/validar-extintor.html [L,QSA]

    # ══════════════════════════════════════════════════════════════════════════
    # PASO 4: Routing interno - todo lo demás va a index.php
    # ══════════════════════════════════════════════════════════════════════════
    RewriteRule ^(.*)$ index.php [L]
</IfModule>

# Ocultar errores PHP al usuario
php_flag display_errors Off

# Permitir acceso a cámara para el scanner QR
<IfModule mod_headers.c>
    Header set Permissions-Policy "camera=(self)"
</IfModule>
