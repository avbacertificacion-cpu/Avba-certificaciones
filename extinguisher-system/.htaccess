DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # CRÍTICO: No reescribir si es un archivo real que existe
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # ESPECIAL: Raíz con ?qr= → PUBLIC VALIDADOR (ANTES de directorio check)
    RewriteCond %{QUERY_STRING} ^qr=
    RewriteRule ^$ public/validar-extintor.html [L,QSA]

    # CRÍTICO: No reescribir si es un directorio real que existe
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # CRÍTICO: Nunca reescribir .php, .js, .css, .jpg, .png, etc. en /public/
    RewriteRule ^public/.*\.(php|html|js|css|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot)$ - [L]

    # Nunca reescribir archivos o directorios bajo /api/
    RewriteRule ^api(/|$) - [L]

    # Nunca reescribir directorios bajo /config/ o /private/
    RewriteRule ^(config|private)(/|$) - [L]

    # Catch-all: Todo lo demás (rutas no existentes) va a index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Ocultar errores PHP al usuario
php_flag display_errors Off

# Permitir acceso a cámara para el scanner QR
<IfModule mod_headers.c>
    Header set Permissions-Policy "camera=(self)"
</IfModule>
