# Descarga de la app AVBA Control de Accesos (la sube .github/workflows/app-caseta.yml):
# https://gestion.avba.com.mx/controlaccesos/descargas/avba-control-accesos.apk
Options -Indexes
AddType application/vnd.android.package-archive .apk
<IfModule mod_headers.c>
  <FilesMatch "\.apk$">
    Header set Content-Disposition "attachment; filename=avba-control-accesos.apk"
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
