# uploads/ — Solo archivos estáticos; nunca ejecutar código
# Mismo patrón que usa el sistema principal, ya probado en este host.
Options -Indexes -ExecCGI

# Bloquear ejecución de PHP y otros lenguajes de servidor
<FilesMatch "\.(php\d*|php\.bak|phtml|phar|pl|py|cgi|sh|asp|aspx|htm|html|shtml)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Forzar descarga de tipos potencialmente peligrosos (SVG con scripts, etc.)
<IfModule mod_headers.c>
    <FilesMatch "\.(svg|svgz|xml)$">
        Header set Content-Disposition "attachment"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>

# Los CV se reemplazan al subir uno nuevo: evitar que el navegador
# muestre una versión anterior en caché.
<IfModule mod_headers.c>
    <FilesMatch "\.pdf$">
        Header always unset Content-Security-Policy
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Lista blanca: solo se sirven imágenes y PDF (CV, fotos y logos)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule \.(jpg|jpeg|png|webp|gif|pdf)$ - [L]
    RewriteRule .* - [F,L]
</IfModule>
