DirectoryIndex index.html

# Sesiones PHP aisladas del sistema principal
php_value session.cookie_path /socioscomerciales

# Permitir que el header Authorization llegue a PHP (algunos hosts lo bloquean)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# No indexar carpetas
Options -Indexes

# No cachear HTML (para que los usuarios siempre vean la última versión)
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>
