DirectoryIndex index.html

# Las sesiones PHP aisladas (session.cookie_path=/socioscomerciales) se
# configuran en .user.ini — este host corre PHP-FPM y no admite php_value aquí.

# Permitir que el header Authorization llegue a PHP (algunos hosts lo bloquean)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# No indexar carpetas
Options -Indexes

# No cachear HTML (para que los usuarios siempre vean la última versión)
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # ── Cabeceras de seguridad ──────────────────────────────────────
  # El portal no debe poder incrustarse en un iframe ajeno: sin esto se
  # puede superponer invisible sobre otra página y hacer que el usuario
  # pulse botones reales creyendo que pulsa otra cosa (clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"

  # Al salir hacia otro dominio solo se manda el origen, nunca la ruta:
  # una URL como ver-perfil.html?id=42 no debe viajar a terceros.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

  # CSP: todo el código del portal es propio y local. 'unsafe-inline' sigue
  # haciendo falta porque las páginas llevan <script> y <style> en línea;
  # aun así, esto corta la carga de scripts de cualquier otro dominio, que
  # es lo que aprovecharía un XSS para exfiltrar la sesión.
  <FilesMatch "\.html$">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
  </FilesMatch>
</IfModule>
