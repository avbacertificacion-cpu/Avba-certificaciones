# ──────────────────────────────────────────────────────────
#  api/ — Solo index.php es el punto de entrada
# ──────────────────────────────────────────────────────────

# Denegar acceso directo a cualquier archivo PHP excepto los permitidos explícitamente
<FilesMatch "^(?!index\.php$).*\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Bloquear acceso a archivos de configuración y backups (accesos-tarjeta.json lo entrega la API)
<FilesMatch "\.(bak|sql|log|ini|sh|env|json)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Deshabilitar listado de directorio
Options -Indexes
