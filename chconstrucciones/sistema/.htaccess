# Sistema de gestión documental — configuración del servidor web (Apache / LiteSpeed de Hostinger)
Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
</IfModule>

# Archivos de texto o respaldo que nunca deben verse.
<FilesMatch "\.(md|sql|log|bak|dist|ejemplo\.php)$|^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Forzar HTTPS (Hostinger da el certificado SSL gratis). Quita el # al tener SSL activo.
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
