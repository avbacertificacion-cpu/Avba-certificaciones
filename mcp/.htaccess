# Protege la configuración y el registro de envíos.
Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(config\.php|\.envios\.json|\.intentos\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Que el servidor no guarde en caché las respuestas del conector.
<IfModule mod_headers.c>
    Header set Cache-Control "no-store"
</IfModule>
