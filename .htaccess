# ──────────────────────────────────────────────────────────
#  AVBA Control de Accesos — gestion.avba.com.mx/controlaccesos/
#  (hereda las cabeceras de seguridad del .htaccess de la raíz del sitio)
# ──────────────────────────────────────────────────────────
DirectoryIndex index.html
Options -Indexes

# Pasar el encabezado Authorization (Bearer) a PHP
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Las páginas se actualizan con cada despliegue: revalidar siempre
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Nada de esto se publica, pero por si acaso
<FilesMatch "(^\.|\.(sql|md|lock|log|ini|sh|env)$|^composer\.json$)">
  Require all denied
</FilesMatch>
