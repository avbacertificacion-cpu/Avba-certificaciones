DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # PASO 0: MANEJO DE QR - DEBE IR PRIMERO
    # Cuando hay ?qr= en la raiz del proyecto (/ o /extintores), servir la
    # pagina publica de validacion SIN pasar por index.php (que redirige a login).
    # Esto debe ir ANTES de las verificaciones -f/-d porque la raiz es un
    # directorio real y de lo contrario PASO 2 cortaria el flujo.
    RewriteCond %{QUERY_STRING} ^qr=
    RewriteRule ^(extintores/?)?$ public/validar-extintor.html [L,QSA]

    # PASO 1: NUNCA reescribir archivos reales que existen
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # PASO 2: NUNCA reescribir directorios reales que existen
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # PASO 3: NUNCA reescribir archivos específicos HTML por nombre
    RewriteRule ^public/validar-extintor\.html$ - [L]
    RewriteRule ^public/login\.html$ - [L]
    RewriteRule ^public/diagnostico\.html$ - [L]
    RewriteRule ^public/test-qr - [L]

    # PASO 4: NUNCA reescribir directorios completos
    RewriteRule ^(public|api|config|private)/ - [L]

    # PASO 5: Routing interno - todo lo demas va a index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Ocultar errores PHP al usuario
php_flag display_errors Off

# Permitir acceso a camara para el scanner QR
<IfModule mod_headers.c>
    Header set Permissions-Policy "camera=(self)"
</IfModule>
